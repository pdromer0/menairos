{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *--no-verify*)",
      "Bash(git commit *--no-verify*)",
      "Bash(gh pr merge *)",
      "Bash(gh api *DELETE*)",
      "Bash(gh repo delete *)"
    ],
    "allow": [
      "Bash(uv run *)",
      "Bash(uv sync *)",
      "Bash(scripts/n1.sh *)",
      "Bash(scripts/n3.sh *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git push *)"
    ]
  }
}
