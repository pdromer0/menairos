#!/usr/bin/env bash
# Parte N3 de la plantilla de juguete juguete2 (solo vive en los tests): anota sus argumentos, uno
# por línea, en .cache/partes/juguete2.n3 y sale con $SALIDA_JUGUETE2 (0 por defecto).
cd "$(dirname "${BASH_SOURCE[0]}")/../../.." || exit 1
mkdir -p .cache/partes
printf '%s\n' "$@" >.cache/partes/juguete2.n3
echo "juguete2 n3: $#"
exit "${SALIDA_JUGUETE2:-0}"
